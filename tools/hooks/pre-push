#!/usr/bin/env bash
# ============================================================================
# pre-push — o que não pode sair de casa, conferido ANTES de enviar.
#
#   uso:  git push            (o hook roda sozinho)
#         tools/hooks/pre-push (conferir sem enviar; saída em stderr)
#
# Instalado por tools/instalar-hooks.sh, por link simbólico em .git/hooks/pre-push.
#
# Duas conferências, as duas MEDIDAS (20/09/2026) — e uma exceção declarada (09/10/2026):
#
#   1) AS SENHAS DOS ACOMPANHAMENTOS não podem estar em arquivo versionado. Elas vivem em
#      `tools/.senhas-locais` — local, no .gitignore, **nunca commitado** —, e o hook as lê DE LÁ:
#      uma definição só (se a senha mudar lá, o hook muda com ela). Se o arquivo não existir, a
#      conferência é declarada como NÃO FEITA, em vez de passar em silêncio (o
#      `gerar-acompanhamento.sh` também sabe pedir a senha na hora, então pode não haver arquivo).
#
#   2) ACOMPANHAMENTO EM TEXTO PURO. O que se versiona é a página **cifrada**
#      (`acompanhamento-<apelido>.html`); o `.md` por aluna — que traz os apelidos em claro — é
#      local e está no .gitignore (`professores/*/ciclos/*-acompanhamento-*.md`). O ALVO desta
#      conferência é o `.md` VERSIONADO. Procurar a palavra `acompanhamento` solta casava também
#      com `tools/gerar-acompanhamento.sh` (a ferramenta) e com as próprias páginas cifradas, que
#      SÃO parte do pacote: o alarme acendia SEMPRE — e alarme que sempre acende não avisa nada.
#
#   EXCEÇÃO — ESCOLAS DE TESTE. Uma escola de TESTE (dados 100% falsos — nenhuma aluna real)
#   não tem segredo a proteger: a "senha" dela é um placeholder conhecido (o próprio slug da
#   escola), e por isso a conferência 1 não se aplica. Essas escolas ficam listadas, uma por
#   linha, em `tools/.escolas-teste` (local, como as senhas); o hook as pula na conferência 1 e
#   declara o porquê. Uma escola REAL nunca pode entrar nessa lista — seria abrir a porta que a
#   conferência fechou.
# ============================================================================
set -uo pipefail

RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ" || exit 1

# O arquivo das senhas é local; o caminho é trocável para o TESTE do próprio hook.
SENHAS="${SENHAS_LOCAIS:-$RAIZ/tools/.senhas-locais}"
# As escolas de TESTE (dados falsos) ficam fora da conferência 1. Local, como as
# senhas: uma slug por linha (`SENHA_DIAGHILEV` → `diaghilev`), `#` para comentário.
ESCOLAS_TESTE="${ESCOLAS_TESTE:-$RAIZ/tools/.escolas-teste}"
erros=0
alerta() { printf 'pre-push: ALERTA — %s\n' "$1" >&2; erros=$((erros + 1)); }

# --- 1) as senhas não podem estar no que está versionado ---------------------
if [ -f "$SENHAS" ]; then
  n=0
  # O `|| [ -n "$nome" ]` NÃO é enfeite: `read` devolve falso ao chegar ao fim do arquivo
  # sem quebra de linha, e o laço terminaria SEM processar a última linha — justamente a que
  # acabou de ser escrita. Medido em 15/10/2026: um `.senhas-locais` cuja última linha era a
  # chave REAL da escola (`SENHA_BARRA`, sem `\n` no fim) era lido como «as 2 senha(s) ok»,
  # com a chave de verdade fora da conferência. Reprodução: um valor igual a «professores»
  # — que existe em centenas de arquivos versionados — passava como ok, sem alerta e sem
  # ruído. Guarda que pisca os olhos na última linha não guarda nada.
  while IFS='=' read -r nome valor || [ -n "$nome" ]; do
    case "$nome" in ''|'#'*) continue ;; esac
    valor="${valor%\"}"; valor="${valor#\"}"
    valor="${valor%\'}"; valor="${valor#\'}"
    [ -n "$valor" ] || continue
    n=$((n + 1))
    # O NOME diz O QUE a linha é, e dele sai o SUJEITO da conferência (e da isenção):
    #   SENHA_<ESCOLA>  — chave de CIFRA (é o que os scripts leem); sujeito = a ESCOLA;
    #   LOGIN_<SLUG>    — senha de ACESSO (Bastidores/Produção); NÃO é chave, e nenhum
    #                     script a lê; sujeito = QUEM ENTRA (a pessoa).
    # As duas são conferidas contra os arquivos versionados — o que se protege é o mesmo.
    # Qualquer outro nome cai no `*)`, e o sujeito é o próprio nome: a conferência não
    # pode depender de a linha ter sido batizada certo.
    case "$nome" in
      SENHA_*) sufixo="${nome#SENHA_}"; classe='chave de cifra' ;;
      LOGIN_*) sufixo="${nome#LOGIN_}"; classe='senha de acesso' ;;
      *)       sufixo="$nome";          classe='valor' ;;
    esac
    sujeito="$(printf '%s' "$sufixo" | tr '[:upper:]' '[:lower:]')"
    # Se o SUJEITO é um declarado de TESTE, a senha não é segredo — a conferência não se
    # aplica. A declaração é por sujeito: vale para a escola (a chave) e para quem entra
    # (o acesso), porque nas duas o que existe é dado 100% falso.
    if [ -n "$sujeito" ] && [ -f "$ESCOLAS_TESTE" ] && grep -qxF "$sujeito" "$ESCOLAS_TESTE"; then
      echo "pre-push: $nome — $classe de TESTE ($sujeito): dados falsos, senha é placeholder; fora da conferência" >&2
      continue
    fi
    if git grep -qF -- "$valor" -- . 2>/dev/null; then
      alerta "a senha de $nome aparece em arquivo VERSIONADO:"
      git grep -nF -- "$valor" -- . | head -5 >&2
    fi
  done < "$SENHAS"
  [ "$erros" -eq 0 ] && echo "pre-push: ok — as $n senha(s) de $(basename "$SENHAS") não estão em arquivo versionado" >&2
else
  echo "pre-push: aviso — $SENHAS não existe: as senhas NÃO foram conferidas" >&2
fi

# --- 2) acompanhamento em texto puro versionado ------------------------------
if git ls-files | grep -q 'acompanhamento.*\.md$'; then
  alerta 'acompanhamento em TEXTO PURO versionado (o que se versiona é a página cifrada):'
  git ls-files | grep 'acompanhamento.*\.md$' | sed 's/^/  /' >&2
else
  cifradas="$(git ls-files | grep -c 'acompanhamento.*\.html$')"
  echo "pre-push: ok — nenhum .md de acompanhamento versionado (as ${cifradas} página(s) cifrada(s) são do pacote)" >&2
fi

if [ "$erros" -gt 0 ]; then
  printf 'pre-push: %d ALERTA(S) — push barrado. Conserte; se for enviar assim mesmo, é --no-verify, sabendo o que faz.\n' "$erros" >&2
  exit 1
fi
exit 0
