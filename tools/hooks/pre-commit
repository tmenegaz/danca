#!/usr/bin/env bash
# ============================================================================
# pre-commit — valida o que está sendo commitado (Regra 17).
#
# Instalado por tools/instalar-hooks.sh (este arquivo é a fonte versionada;
# .git/hooks não é versionado pelo Git).
#
# O que faz:
#   1) barra arquivos GERADOS no stage (defesa contra .gitignore furado);
#   2) valida a âncora FIPP, o PO, o plano do ciclo e os dados (o `-dados.json` do
#      lançamento por aula) de cada ciclo tocado;
#   3) se o registro/glossário Benesh entrou no stage, valida a consistência
#      entre os dois (todo símbolo do corpo precisa de verbete);
#   4) se o PLANO DE UMA AULA (`aula-NN.md`) entrou no stage, valida-o contra o
#      schema da aula e, com a aula já LANÇADA, exige que a edição seja só
#      ACRÉSCIMO — o elo novo (`## Ajuste do plano da aula NN`) no fim, o
#      passado intacto (§1.1/§1.2: o anterior permanece, o novo é um elo);
#   5) para cada ciclo tocado, roda o gerador + validador do pacote (ciclo-zero — DOCS
#      vazio, o scaffold de escola — é pulado SEM erro);
#   6) se a apresentação foi tocada, roda os validadores do deck;
#   7) se entraram no stage tools/, os assets de um pacote de ciclo ou o deck,
#      valida a identidade visual (paleta com cópia única e cópias em dia).
# ============================================================================
set -uo pipefail

RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ" || exit 1

arquivos="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$arquivos" ] && exit 0

# ---------------------------------------------------------------------------
# 1) saídas geradas não entram no histórico: são reconstruíveis das fontes
# ---------------------------------------------------------------------------
# Os pacotes de ciclo (professores/*/ciclos/ciclo-NN-escola/) SÃO versionados, porque o
# deploy é automático a partir do GitHub — por isso a exceção no fim do filtro. O `out/`
# da apresentação, os .pptx e os PNGs de slide seguem barrados.
#
# A EXCEÇÃO TINHA UM DEFEITO (20/10/2026). Ela exigia `[a-z0-9]+` depois de `ciclo-NN-`, e o nome
# de uma variante tem HIFENS: `ciclo-01-batata-bale-nivel-1-teste-2`. Com isso o PDF do pacote — que
# a exceção existe precisamente para deixar passar — era recusado em todas as variantes, e só
# passava o de um ciclo sem escola no nome. O `-` entra na classe, e o `[a-z0-9]` inicial impede que
# o segmento seja vazio.
gerados="$(printf '%s\n' "$arquivos" \
  | grep -E '^(out/|.*\.pdf$|.*\.pptx$|.*/img/slide-.*\.png$)' \
  | grep -vE '^professores/[^/]+/ciclos/ciclo-[0-9]+-[a-z0-9][a-z0-9-]*/' || true)"
if [ -n "$gerados" ]; then
  echo "pre-commit: arquivos gerados no stage (não versionar — são reconstruíveis):" >&2
  printf '  %s\n' $gerados >&2
  echo "  remova com: git restore --staged <arquivo>   (ver .gitignore)" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 2) âncora FIPP: fontes de ciclo não entram no histórico com a âncora
#    desatualizada — e a âncora que vai no commit tem de ser a mesma do disco
#    (P-03: FIPP alinha; o passado não é reescrito, é incorporado)
#    O material é por professor (P-13): os alvos são professores/<p>/ciclos/ciclo-NN.
# ---------------------------------------------------------------------------
alvos_hash="$(printf '%s\n' "$arquivos" | grep -oE '^professores/[^/]+/ciclos/ciclo-[0-9]+' | sort -u || true)"
for alvo in $alvos_hash; do
  prof="$(printf '%s' "$alvo" | sed 's|^professores/||; s|/ciclos/.*||')"
  numero="$(printf '%s' "$alvo" | sed 's|.*/ciclos/ciclo-||')"
  base="professores/$prof/ciclos"
  variantes_hash="$(printf '%s\n' "$arquivos" \
    | grep -oE "^professores/$prof/ciclos/ciclo-$numero-[a-z0-9]+\.conf$" \
    | sed "s|^professores/$prof/ciclos/ciclo-$numero-||; s|\.conf$||" | sort -u || true)"
  if [ -z "$variantes_hash" ]; then
    variantes_hash="$(ls -1 "$base"/ciclo-"$numero"-*.conf 2>/dev/null \
      | sed "s|.*/ciclo-$numero-||; s|\.conf$||" || true)"
  fi

  for v in $variantes_hash; do
    fipp="$base/ciclo-$numero-$v.fipp"
    if ! tools/hash-ciclo.sh "$prof" "$numero" "$v" --check > /tmp/pre-commit-hash-"$prof-$numero-$v".log 2>&1; then
      echo "pre-commit: recusado — a âncora FIPP do ciclo-$numero-$v (professor $prof) está desatualizada." >&2
      grep -E '^erro|^aviso' /tmp/pre-commit-hash-"$prof-$numero-$v".log | head -6 >&2
      echo "  regere a âncora: tools/hash-ciclo.sh $prof $numero $v" >&2
      exit 1
    fi
    # a âncora que entra no commit tem de ser a mesma que está no disco
    if git cat-file -e ":$fipp" 2>/dev/null; then
      if ! diff -q <(git show ":$fipp") "$fipp" > /dev/null 2>&1; then
        echo "pre-commit: $fipp está no stage numa versão diferente da atual." >&2
        echo "  re-adicione: git add $fipp" >&2
        exit 1
      fi
    fi
    echo "pre-commit: âncora FIPP do $prof/ciclo-$numero-$v ok"

    # PO da variante: uma vez por variante, DENTRO do laço. O PO é do professor
    # (P-13) e cada variante (escola) tem o seu. (Antes esta checagem rodava depois do
    # laço, uma vez por ciclo, e validava só a última variante — por causa do $v que
    # sobrava da última iteração; duo e debora nunca eram validadas por commit.)
    arquivo_po="$base/ciclo-$numero-$v-po.md"
    schema_po="$base/ciclo-$numero-po-schema.json"
    if [ -f "$arquivo_po" ] && [ -f "$schema_po" ]; then
      if ! node tools/validar-po-ciclo.js "$schema_po" "$arquivo_po" > /tmp/pre-commit-po-"$prof-$numero-$v".log 2>&1; then
        echo "pre-commit: recusado — o PO da variante $prof/ciclo-$numero-$v não satisfaz o schema do PO." >&2
        grep -E '^  - |^erro' /tmp/pre-commit-po-"$prof-$numero-$v".log | head -6 >&2
        exit 1
      fi
      echo "pre-commit: PO da variante $prof/ciclo-$numero-$v validado"
    elif [ -f "$arquivo_po" ]; then
      echo "pre-commit: aviso — $arquivo_po existe sem schema ($schema_po); PO não validado" >&2
    fi

    # DADOS do ciclo: o JSON de dados é a FONTE do lançamento por aula (§4.1/§4.3/§4.6), e ele
    # não tem schema em arquivo — as regras são INLINE no validador (um `-dados-schema.json`
    # exigiria um por escola). A variante tem precedência sobre o compartilhado, como o plano e
    # como o tools/lib-fontes.sh. Sem dados, PULA sem falhar: o ciclo ainda não teve lançamento.
    arquivo_dados="$base/ciclo-$numero-$v-dados.json"
    [ -f "$arquivo_dados" ] || arquivo_dados="$base/ciclo-$numero-dados.json"
    if [ -f "$arquivo_dados" ]; then
      if ! node tools/validar-dados-ciclo.js "$arquivo_dados" \
           > /tmp/pre-commit-dados-"$prof-$numero-$v".log 2>&1; then
        echo "pre-commit: recusado — os dados do $prof/ciclo-$numero (variante $v) não satisfazem as regras do lançamento (§4.1, §4.3, §4.6)." >&2
        grep -E '^  - |^erro' /tmp/pre-commit-dados-"$prof-$numero-$v".log | head -6 >&2
        exit 1
      fi
      echo "pre-commit: dados do $prof/ciclo-$numero (variante $v) validados"
      # As lacunas do §4.6 são DECLARADAS, não erro: o JSON cobre a aula, não o PO nem o plano.
      grep 'lacunas declaradas' /tmp/pre-commit-dados-"$prof-$numero-$v".log | sed 's/^ */    /' >&2 || true
    fi

    # PLANO do ciclo: o schema é do CICLO (P-08), como o do PO; a FONTE pode ser própria da
    # variante — `ciclo-XX-<escola>-plano.md` tem precedência sobre `ciclo-XX-plano.md`, que é
    # a MESMA regra do tools/lib-fontes.sh. Sem nenhuma das duas, o plano não existe para esta
    # variante: PULA, sem falhar (um ciclo sem plano ainda não é erro de commit — e, quando o
    # plano É fonte do FIPP, quem recusa antes é a âncora, com um motivo melhor).
    schema_plano="$base/ciclo-$numero-plano-schema.json"
    arquivo_plano="$base/ciclo-$numero-$v-plano.md"
    [ -f "$arquivo_plano" ] || arquivo_plano="$base/ciclo-$numero-plano.md"
    if [ -f "$arquivo_plano" ] && [ -f "$schema_plano" ]; then
      if ! node tools/validar-plano-ciclo.js "$schema_plano" "$arquivo_plano" \
           > /tmp/pre-commit-plano-"$prof-$numero-$v".log 2>&1; then
        echo "pre-commit: recusado — o plano do $prof/ciclo-$numero (variante $v) não satisfaz o schema do plano." >&2
        grep -E '^  - |^erro' /tmp/pre-commit-plano-"$prof-$numero-$v".log | head -6 >&2
        exit 1
      fi
      echo "pre-commit: plano do $prof/ciclo-$numero (variante $v) validado"
      # AS LACUNAS DECLARADAS NÃO BLOQUEIAM: `[Preencher]` é legítimo (como no PO) — é a
      # pesquisadora que ainda não decidiu, ou o dado que vem do .conf (o calendário). O
      # validador já sai 0 com elas; aqui elas viram AVISO.
      grep 'provisórios' /tmp/pre-commit-plano-"$prof-$numero-$v".log | sed 's/^ */    /' >&2 || true
    elif [ -f "$arquivo_plano" ]; then
      echo "pre-commit: aviso — $arquivo_plano existe sem schema ($schema_plano); plano não validado" >&2
    fi
  done
done

# ---------------------------------------------------------------------------
# 2b) registro Benesh × glossário: o glossário tem de ser exaustivo (Regra 16)
#     Roda sobre as FONTES, antes de gerar: falha barata e cedo.
# ---------------------------------------------------------------------------
arquivos_glossario="$(printf '%s\n' "$arquivos" \
  | grep -E '^professores/[^/]+/ciclos/ciclo-[0-9]+-(notacao|glossario-benesh)\.md$' || true)"
if [ -n "$arquivos_glossario" ]; then
  for alvo in $(printf '%s\n' "$arquivos_glossario" | grep -oE '^professores/[^/]+/ciclos/ciclo-[0-9]+' | sort -u); do
    gp="$(printf '%s' "$alvo" | sed 's|^professores/||; s|/ciclos/.*||')"
    gn="$(printf '%s' "$alvo" | sed 's|.*/ciclos/ciclo-||')"
    registro_md="professores/$gp/ciclos/ciclo-$gn-notacao.md"
    glossario_md="professores/$gp/ciclos/ciclo-$gn-glossario-benesh.md"
    if [ -f "$registro_md" ] && [ -f "$glossario_md" ]; then
      if node tools/check-glossario.js "$registro_md" "$glossario_md" > /tmp/pre-commit-glossario-"$gp-$gn".log 2>&1; then
        echo "pre-commit: glossário Benesh do $gp/ciclo $gn ok ($(grep -c '  aviso ' /tmp/pre-commit-glossario-"$gp-$gn".log) aviso(s))"
      else
        echo "pre-commit: recusado — o glossário Benesh do $gp/ciclo $gn não bate com o registro." >&2
        grep -E '  ERRO|FALHOU' /tmp/pre-commit-glossario-"$gp-$gn".log | head -6 >&2
        exit 1
      fi
    else
      echo "pre-commit: aviso — registro ou glossário Benesh do $gp/ciclo $gn ausente; consistência não verificada" >&2
    fi
  done
fi

# ---------------------------------------------------------------------------
# 2c) PLANO DE UMA AULA tocado (`aula-NN.md`): valida contra o schema da aula e,
#     com a aula JÁ LANÇADA, exige que a edição seja só ACRÉSCIMO (§1.1/§1.2).
#
#     É esta a razão declarada do congelamento deste arquivo (ARQUITETURA-AULA.md §8:
#     "distinguir plano antes × depois da aula"). Até o lançamento, `aula-NN.md` é
#     INTENÇÃO e a edição é LIVRE — inclusive para a aula que não aconteceu, que não
#     se declara em lugar nenhum (§1, literal: "A aula não dada não é declarada — é o
#     que sobra"). Do LANÇAMENTO em diante o plano é FATO: o anterior permanece, o
#     novo é um elo, e o diff é a justificativa (§1.2).
#
#     O elo é um bloco `## Ajuste do plano da aula NN` anexado ao FIM do arquivo, e é do
#     PROFESSOR: aqui só se confere que nada acima dele mudou e que o que já estava lá
#     continua lá. NÃO é o formulário que o escreve: `exportarAjusteDoPlano` e a barra
#     `#acoes-plano` que a sustentava saíram de tools/templates/lancamento.html em
#     28/09/2026 (17ed444) — não havia consumidor para o elo do plano, porque o ajuste que
#     fecha no LANÇAMENTO é o DO LANÇAMENTO (§3) e já tem o seu par. Este guard nunca
#     dependeu dela: ele lê a FONTE `aula-NN.md` e a defere contra o HEAD — não lê id
#     nenhum de HTML.
#
#     O QUE NÃO ENTRA: `-captura-aula-NN.md` (material de observação, não plano). E o
#     guard é obrigatório, não precaução: a fonte COMPARTILHADA `ciclo-NN-captura-aula-NN.md`
#     casa com o padrão do plano e seria lida como variante `captura`.
#
#     QUEM MANDA é o `ciclos.json` do PACOTE da variante (`aulas[].lancada`), não o
#     cabeçalho do .md: o estado é DERIVADO (§4.2). Uma fonte COMPARTILHADA alimenta
#     TODAS as variantes do professor (tools/lib-fontes.sh) — logo, se QUALQUER variante
#     que ela alimenta está lançada, o acréscimo é exigido, e a mensagem diz quais.
#
#     Sem schema, sem índice ou sem HEAD: AVISO, nunca recusa — o hook não inventa uma
#     trava que a fonte não sustenta.
# ---------------------------------------------------------------------------
arquivos_aula="$(printf '%s\n' "$arquivos" \
  | grep -E '^professores/[^/]+/ciclos/ciclo-[0-9]+(-[a-z0-9]+)?-aula-[0-9]{2}\.md$' \
  | grep -v 'captura-aula-' || true)"
for fonte_aula in $arquivos_aula; do
  pa="$(printf '%s' "$fonte_aula" | sed 's|^professores/||; s|/ciclos/.*||')"
  na="$(printf '%s' "$fonte_aula" | sed 's|.*/ciclos/ciclo-||; s|-.*||')"
  bn="$(basename "$fonte_aula")"
  # `ciclo-NN-<variante>-aula-NN.md` × `ciclo-NN-aula-NN.md` (compartilhada): a variante sai
  # do NOME, e é o VAZIO que diz que a fonte serve a todas as variantes do professor.
  va="$(printf '%s' "$bn" | sed -n "s|^ciclo-$na-\([a-z0-9]\+\)-aula-[0-9]\{2\}\.md\$|\1|p")"
  nn="$(printf '%s' "$bn" | sed -n "s|^ciclo-$na-\([a-z0-9]\+\)-aula-\([0-9]\{2\}\)\.md\$|\2|p")"
  if [ -z "$nn" ]; then
    nn="$(printf '%s' "$bn" | sed -n "s|^ciclo-$na-aula-\([0-9]\{2\}\)\.md\$|\1|p")"
  fi
  if [ -z "$nn" ]; then
    echo "pre-commit: aviso — não consegui ler o número da aula em $fonte_aula; não validado" >&2
    continue
  fi
  base_aula="professores/$pa/ciclos"

  # VALIDAÇÃO: uma vez por FONTE — o schema da aula é do PROFESSOR, não da variante.
  schema_aula="$base_aula/ciclo-$na-aula-schema.json"
  log_aula="/tmp/pre-commit-aula-$pa-$na-$nn.log"
  if [ ! -f "$schema_aula" ]; then
    echo "pre-commit: aviso — $schema_aula ausente; plano da aula $nn de $pa/ciclo-$na não validado" >&2
  elif ! node tools/validar-aula-ciclo.js "$schema_aula" "$fonte_aula" > "$log_aula" 2>&1; then
    echo "pre-commit: recusado — o plano da aula $nn de $pa/ciclo-$na não satisfaz o schema da aula." >&2
    grep -E '^  - |^erro' "$log_aula" | head -6 >&2
    exit 1
  else
    echo "pre-commit: plano da aula $nn de $pa/ciclo-$na validado"
    # Lacunas e avisos NÃO bloqueiam: `[Preencher]` é decisão da pesquisadora ainda pendente,
    # e o aviso aponta seção que a extração deixou de fora (um `##` fora do mapa de seções).
    grep 'provisórios' "$log_aula" | sed 's/^ */    /' >&2 || true
    grep 'avisos:' "$log_aula" | sed 's/^ */    /' >&2 || true
  fi

  # ESTADO: do índice do PACOTE da variante (`ciclos[].aulas[].lancada`), nunca do .md.
  variantes_aula="$va"
  if [ -z "$variantes_aula" ]; then
    variantes_aula="$(ls -1 "$base_aula"/ciclo-"$na"-*.conf 2>/dev/null \
      | sed "s|.*/ciclo-$na-||; s|\.conf\$||" || true)"
  fi
  if [ -z "$variantes_aula" ]; then
    echo "pre-commit: aviso — $pa/ciclo-$na sem variantes por escola; estado da aula $nn não verificado" >&2
    continue
  fi
  lancada_em=""
  aviso_indice=""
  for v in $variantes_aula; do
    indice_aula="$base_aula/ciclo-$na-$v/ciclos.json"
    if [ ! -f "$indice_aula" ]; then
      aviso_indice="${aviso_indice:+$aviso_indice, }$v (sem ciclos.json)"
      continue
    fi
    # `process.argv.slice(1)` com `node -e` = os argumentos do usuário (medido).
    sinal="$(node -e '
const fs = require("fs");
const [arq, ci, au] = process.argv.slice(1);
let r = "ausente";
try {
  const j = JSON.parse(fs.readFileSync(arq, "utf8"));
  const c = (j.ciclos || []).find((x) => x.id === ci);
  const a = c ? (c.aulas || []).find((x) => x.n === au) : null;
  r = a ? (a.lancada ? "lancada" : "aberta") : "ausente";
} catch (e) { r = "ilegivel"; }
process.stdout.write(r);
' "$indice_aula" "$na" "$nn" 2>/dev/null || true)"
    case "$sinal" in
      lancada)  lancada_em="${lancada_em:+$lancada_em, }$v" ;;
      ausente)  aviso_indice="${aviso_indice:+$aviso_indice, }$v (aula $nn fora do índice)" ;;
      ilegivel) aviso_indice="${aviso_indice:+$aviso_indice, }$v (índice ilegível)" ;;
    esac
  done
  if [ -n "$aviso_indice" ]; then
    echo "pre-commit: aviso — estado da aula $nn de $pa/ciclo-$na não verificado em: $aviso_indice" >&2
  fi
  if [ -z "$lancada_em" ]; then
    continue
  fi

  # ACRÉSCIMO: a aula está LANÇADA ⇒ o passado não se reescreve. Compara-se o PREFIXO
  # (tudo antes do primeiro elo) com o do HEAD, e o elo do HEAD linha a linha.
  head_aula="/tmp/pre-commit-aula-$pa-$na-$nn.head"
  if ! git cat-file -e "HEAD:$fonte_aula" 2>/dev/null; then
    echo "pre-commit: aviso — $fonte_aula é novo e a aula $nn já está lançada ($lancada_em); acréscimo não confrontado com o HEAD" >&2
  else
    git show "HEAD:$fonte_aula" > "$head_aula" 2>/dev/null || true
    pref_atual="$(sed '/^## Ajuste do plano da aula /,$d' "$fonte_aula")"
    pref_head="$(sed '/^## Ajuste do plano da aula /,$d' "$head_aula")"
    if [ "$pref_atual" != "$pref_head" ]; then
      echo "pre-commit: recusado — o plano da aula $nn de $pa/ciclo-$na já foi LANÇADO ($lancada_em): do lançamento em diante o plano é FATO." >&2
      echo "  a intenção não se reescreve; o ajuste é um elo NOVO, no fim do arquivo (§1.1/§1.2)." >&2
      echo "  o formulário de lançamento NÃO exporta mais esse elo (o botão saiu em 17ed444): anexe o bloco '## Ajuste do plano da aula $nn' ao fim de $fonte_aula." >&2
      exit 1
    fi
    cauda_head="$(sed -n '/^## Ajuste do plano da aula /,$p' "$head_aula")"
    if [ -n "$cauda_head" ]; then
      n_elo="$(printf '%s\n' "$cauda_head" | grep -c '')"
      cauda_atual="$(sed -n '/^## Ajuste do plano da aula /,$p' "$fonte_aula")"
      if [ "$(printf '%s\n' "$cauda_atual" | head -n "$n_elo")" != "$cauda_head" ]; then
        echo "pre-commit: recusado — o elo já registrado no plano da aula $nn de $pa/ciclo-$na foi alterado ou removido." >&2
        echo "  o elo anterior permanece; um ajuste novo é outro elo, anexado depois dele (§1.1/§1.2)." >&2
        exit 1
      fi
    fi
    echo "pre-commit: plano da aula $nn de $pa/ciclo-$na preserva o passado lançado ($lancada_em)"
  fi
done

# ---------------------------------------------------------------------------
# 3) ciclos tocados: gerar e validar (uma variante por escola), por professor
# ---------------------------------------------------------------------------
ciclos="$(printf '%s\n' "$arquivos" | grep -oE '^professores/[^/]+/ciclos/ciclo-[0-9]+' | sort -u || true)"
for c in $ciclos; do
  prof="$(printf '%s' "$c" | sed 's|^professores/||; s|/ciclos/.*||')"
  numero="$(printf '%s' "$c" | sed 's|.*/ciclos/ciclo-||')"
  base="professores/$prof/ciclos"

  # variantes citadas nos próprios caminhos do stage (manifesto ou pacote);
  # se nenhuma for citada (fonte compartilhada, manifesto base), valida todas
  variantes="$(printf '%s\n' "$arquivos" \
    | grep -oE "^professores/$prof/ciclos/ciclo-$numero-[a-z0-9]+\.conf$" \
    | sed "s|^professores/$prof/ciclos/ciclo-$numero-||; s|\.conf$||" | sort -u || true)"
  if [ -z "$variantes" ]; then
    variantes="$(ls -1 "$base"/ciclo-"$numero"-*.conf 2>/dev/null \
      | sed "s|.*/ciclo-$numero-||; s|\.conf$||" || true)"
    if [ -z "$variantes" ]; then
      echo "pre-commit: $prof/ciclo-$numero sem variantes por escola — nada a gerar (Pré-requisito 5)." >&2
      continue
    fi
  fi

  for v in $variantes; do
    # CICLO-ZERO (DOCS vazio) não tem o que gerar: é o scaffold de uma escola recém-criada
    # pela página — o Pré-requisito 5 está atendido (escola + frequência + contexto), mas
    # nenhum documento ainda foi escrito. O gerador RECUSA com `defina DOCS` (gerar-ciclo.sh
    # §102), o que obrigava o scaffold a entrar por `--no-verify` ou pelo CI (que não instala
    # o hook). Aqui pulamos SEM erro, para o scaffold entrar por commit normal. A derivação é
    # a MESMA do gerador: base sobrescrita pela variante (tools/lib-fontes.sh).
    conf_base="$base/ciclo-$numero.conf"
    conf_variante="$base/ciclo-$numero-$v.conf"
    docs_do_ciclo="$( ( [ -f "$conf_base" ] && source "$conf_base"; [ -f "$conf_variante" ] && source "$conf_variante"; printf '%s' "${DOCS:-}" ) )"
    if [ -z "$docs_do_ciclo" ]; then
      echo "pre-commit: $prof/ciclo-$numero-$v é ciclo-zero (DOCS vazio) — nada a gerar (scaffold de escola)."
      continue
    fi
    # A VARIANTE PLANEJADA E AINDA SEM AULA NÃO SE GERA (20/10/2026).
    #
    # Uma turma pode ter PLANO e ainda não ter PO — é o estado normal entre a fase 2 e a fase 3
    # do ciclo, e o `calango` esteve nele com três turmas: o plano das três, o PO de uma. O
    # gerador RECUSA essa variante com a frase certa («nenhuma 'aula-*' de DOCS tem fonte em
    # disco», `gerar-ciclo.sh` §193), e o hook tomava a recusa por falha: nenhum commit passava
    # enquanto a segunda turma não tivesse PO. Um estado legítimo do sistema a bloquear o
    # repositório inteiro — e o caminho que sobrava era `--no-verify`, que salta TAMBÉM a âncora.
    #
    # O critério é o do gerador, e não um segundo: `DOCS` sem nenhum `aula-*` é a mesma coisa que
    # «não há aula com fonte». Um `DOCS` com aula e sem volume continua a FALHAR — é defeito de
    # conteúdo, e tem de aparecer.
    case " $docs_do_ciclo " in
      *" aula-"*) ;;
      *)
        echo "pre-commit: $prof/ciclo-$numero-$v declara DOCS=\"$docs_do_ciclo\" e ainda não tem aula — nada a gerar (plano sem PO)."
        continue
        ;;
    esac
    echo "pre-commit: gerando e validando $prof/ciclo-$numero-$v ..."
    if ! tools/gerar-ciclo.sh "$prof" "$numero" "$v" > /tmp/pre-commit-ciclo-"$prof-$numero-$v".log 2>&1; then
      echo "pre-commit: FALHOU ao gerar $prof/ciclo-$numero-$v — nada foi commitado." >&2
      grep -E 'erro|ERRO|FALHOU|! LaTeX Error' /tmp/pre-commit-ciclo-"$prof-$numero-$v".log | head -8 >&2
      exit 1
    fi
    echo "pre-commit: $prof/ciclo-$numero-$v OK ($(grep -c '  ok ' /tmp/pre-commit-ciclo-"$prof-$numero-$v".log) verificações passaram)"
  done
done

# ---------------------------------------------------------------------------
# 4) apresentações tocadas: validar o deck
# ---------------------------------------------------------------------------
if printf '%s\n' "$arquivos" | grep -q '^apresentacoes/'; then
  echo "pre-commit: validando o deck ..."
  node tools/check-overflow.js > /tmp/pre-commit-deck.log 2>&1 || {
    echo "pre-commit: FALHOU a validação do deck (estouro de slide)." >&2; tail -5 /tmp/pre-commit-deck.log >&2; exit 1; }
  node tools/check-mapa.js > /tmp/pre-commit-mapa.log 2>&1 || {
    echo "pre-commit: FALHOU a validação do mapa." >&2; tail -5 /tmp/pre-commit-mapa.log >&2; exit 1; }
  tail -1 /tmp/pre-commit-deck.log
fi

# ---------------------------------------------------------------------------
# 5) identidade visual: a paleta tem UM só lugar, e as cópias têm de estar em dia
#    (IDENTIDADE-VISUAL.md). A âncora .fipp NÃO cobre isto: o tools/templates/ciclo.css
#    mora em tools/, que não é fonte de ciclo — logo este validador é a ÚNICA trava da
#    identidade. Sem ele, um hex novo em tools/templates/ciclo.css e as páginas servidas
#    divergindo passam em silêncio.
#
#    GUARD ESTREITO, pelo que o validador de fato LÊ — não por precaução:
#      a) `tools/` — a fonte (tools/templates/ciclo.css, tools/templates/nav.js) e os
#         consumidores que ele varre atrás de hex redeclarado (os dois templates HTML e
#         os scripts de geração/hash);
#      b) `professores/<p>/ciclos/ciclo-NN-<escola>/assets/` — a checagem "Circuito"
#         compara byte a byte a cópia do pacote com a fonte; é a única parte de
#         professores/ que ele lê;
#      c) `raiz/assets/`, `porta/` e `motor/` — as superfícies que ele passou a varrer em
#         16/10/2026 (a cópia da raiz, a porta, os bastidores, a ficha e as páginas de
#         estado). Antes, mudar qualquer uma delas não disparava validação nenhuma;
#      d) o deck do Rizoma — único consumidor que DECLARA os hex (Marp não referencia
#         token), e por isso ele entra sozinho, e não todo o `apresentacoes/`.
#    Um commit de docs, biblioteca, PO, plano ou só de fontes de ciclo NÃO pode
#    afetá-lo — e o hook já é pesado o bastante para não rodá-lo por nada.
#
#    Roda DEPOIS do 3) de propósito: é o gerador que recopia tools/templates/ para
#    dentro do pacote, então a checagem de circuito tem de ver o pacote JÁ regenerado.
# ---------------------------------------------------------------------------
if printf '%s\n' "$arquivos" | grep -qE '^(tools/|raiz/assets/|porta/|motor/|professores/[^/]+/ciclos/ciclo-[0-9]+-[a-z0-9]+/assets/|apresentacoes/apresentacao-01-rizoma/apresentacao-ballet\.md$)'; then
  echo "pre-commit: validando a identidade visual ..."
  if node tools/check-identidade.js > /tmp/pre-commit-identidade.log 2>&1; then
    echo "pre-commit: identidade visual ok ($(grep -c '^ok: ' /tmp/pre-commit-identidade.log) verificações passaram)"
  else
    echo "pre-commit: recusado — a identidade visual não se sustenta." >&2
    grep -E '^erro: ' /tmp/pre-commit-identidade.log | head -6 >&2
    echo "  a paleta mora só em tools/templates/ciclo.css; regenere o pacote se a cópia divergiu" >&2
    echo "  ver IDENTIDADE-VISUAL.md" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# 11) O MOLDE E OS SCHEMAS DOS PROFESSORES DIZEM O MESMO CONTRATO
#
#     O caso que originou isto (01/11/2026): os `required` do schema do plano foram corrigidos
#     em doze professores e NÃO no molde; os cinco professores criados depois (cópia do molde)
#     nasceram a exigir `ciclo` e `rubrica`, que a derivação deixou de escrever — e a geração
#     de um ciclo morreu em «campo ausente», depois do PO já ter passado.
#
#     A cópia sem comparação é uma segunda verdade. Aqui é onde ela se descobre, e é barato: são
#     dezoito ficheiros pequenos, lidos de uma vez. Sempre que o stage toca num schema ou no
#     molde — não vale a pena correr por um commit de conteúdo.
# ---------------------------------------------------------------------------
if printf '%s\n' "$arquivos" | grep -qE '^(modelo/ciclos/|professores/[^/]+/ciclos/ciclo-[0-9]+-.+-schema\.json$|motor/servidor/schemas-do-ciclo\.js$)'; then
  echo "pre-commit: conferindo o molde dos schemas contra os professores ..."
  if node tools/check-schemas.js > /tmp/pre-commit-schemas.log 2>&1; then
    echo "pre-commit: molde e professores dizem o mesmo contrato ($(grep -c '^ok ' /tmp/pre-commit-schemas.log) verificações)"
  else
    echo "pre-commit: recusado — o molde dos schemas e os professores divergem." >&2
    grep -E '^FALHA' /tmp/pre-commit-schemas.log | head -4 >&2
    echo "  o molde é a fonte dos schemas de quem entra; um campo obrigatório a mais recusa" >&2
    echo "  todo documento derivado. Alinhe os dois antes de commitar." >&2
    exit 1
  fi
fi

exit 0
