// Cloudflare Worker da escola Batata (professor tiago-menegaz) — ciclo 01.
//
// UM PROJETO POR ESCOLA — irmão dos wrangler.<escola>.jsonc: mesmo código
// (workers/principal.js), mesmo KV compartilhado (as chaves são prefixadas por
// escola) — muda só o name, o assets.directory, o ESCOLA_SLUG e o routes.
// Gerado por tools/criar-escola.sh.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "batata",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },

  "main": "workers/principal.js",

  // O PACOTE DA TURMA, NÃO O ESQUELETO (20/10/2026). O `criar-escola.sh` (congelado) grava aqui o
  // `ciclo-01-<escola>`, que é o pacote-zero: o scaffold da escola, com o DOCS vazio. O ciclo gerado
  // sai ao lado, em `ciclo-01-<escola>-<variante>`, e o Worker servia o esqueleto — o pacote existia
  // no repositório e o site da escola não o mostrava. Foi assim com a `breu` e é assim aqui. Um
  // Worker só tem um `assets.directory`, portanto isto continua a ser uma escola por turma: a
  // correcção estrutural é o pacote-zero passar a ser um índice de turmas.
  "assets": {
    "directory": "professores/tiago-menegaz/ciclos/ciclo-01-batata-bale-nivel-1-teste-2",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "vars": {
    "ESCOLA_HABILITADA": "sim",
    "ESCOLA_SLUG": "batata"
  },

  "kv_namespaces": [
    {
      "binding": "PADD_KV",
      "id": "2ee331c7a5bc446ca86c8f2cb039ec16"
    }
  ]
}
