// Cloudflare Worker da escola breu (professor redinha-rosa) — ciclo 01.
//
// UM PROJETO POR ESCOLA — irmão dos wrangler.<escola>.jsonc: mesmo código
// (workers/principal.js), mesmo KV compartilhado (as chaves são prefixadas por
// escola) — muda só o name, o assets.directory e o routes. A ESCOLA não está aqui: vem do
// mapa em KV, e é o que deixa a identidade de depender do deploy.
// Gerado por tools/criar-escola.sh.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breu",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },

  "main": "workers/principal.js",

  // A PUBLICAÇÃO MONTADA, NÃO O ESQUELETO (20/10/2026). Aqui esteve
  // "professores/redinha-rosa/ciclos/ciclo-01-breu" — o pacote-zero, que é a apresentação do
  // sistema e não tem DOCS: o site nascia sem Ciclo nem Aulas, e o ciclo gerado (que sai ao lado,
  // em ciclo-NN-<escola>-<turma>/) nunca aparecia. Foi assim com a breu, com a batata e com o
  // calango.  é montado por tools/montar-publicacao.js: o índice das
  // turmas, a apresentação, a porta e um subdirectório por pacote. Não é versionado.
  // OS ASSETS NÃO PRECISAM DE INVOCAR O WORKER (13/11/2026).  aqui fazia o CSS, o
  //  e o favicon gastarem uma invocação cada — e o plano gratuito cobra 100.000 por dia
  // e conta cada uma, enquanto um asset servido pelo ASSETS é grátis e ilimitado. As duas
  // negativas (precedência sobre ) mandam os assets direto para o ASSETS: a pasta de cada
  // pacote, e a dos prefixos da porta. O HTML e o motor continuam no Worker, que é quem injeta a
  // aparência da escola e o freio. Os scripts GERADOS pelo motor moram em , fora do
  // alcance destas regras — ver .
  "assets": {
    "directory": "publicacao/breu",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/*/assets/*",
      "!/*.pdf"
    ]
  },

  // A ESCOLA NÃO SE DECLARA AQUI (13/11/2026). Aqui esteve , e era ela
  // que dizia de quem era o Worker. Passa a vir do mapa , em KV
  // (), que o workflow publica ANTES deste deploy — a ordem é
  // a única que não cria uma escola sem ninguém que a reclame.
  "vars": {
    "ESCOLA_HABILITADA": "sim"
  },

  "kv_namespaces": [
    {
      "binding": "PADD_KV",
      "id": "2ee331c7a5bc446ca86c8f2cb039ec16"
    }
  ]
}
