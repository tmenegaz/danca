// Cloudflare Worker da escola Fita (professor tiago-menegaz) — ciclo 01.
//
// UM PROJETO POR ESCOLA — irmão dos wrangler.<escola>.jsonc: mesmo código
// (workers/principal.js), mesmo KV compartilhado (as chaves são prefixadas por
// escola) — muda só o name, o assets.directory, o ESCOLA_SLUG e o routes.
// Gerado por tools/criar-escola.sh.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fita",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },

  "main": "workers/principal.js",

  "assets": {
    "directory": "professores/tiago-menegaz/ciclos/ciclo-01-fita",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "vars": {
    "ESCOLA_HABILITADA": "sim",
    "ESCOLA_SLUG": "fita",
    "FUSO": "America/Sao_Paulo"
  },

  "kv_namespaces": [
    {
      "binding": "PADD_KV",
      "id": "2ee331c7a5bc446ca86c8f2cb039ec16"
    }
  ]
}
