// Cloudflare Worker da RAIZ do sistema — o `danca`.
//
// NÃO é uma escola: é a porta de entrada do sistema. Serve a apresentação «Sistema Lastro»
// (a MESMA do ciclo, renderizada de biblioteca/apresentacao.md) + o botão «Criar nova
// escola», atrás de senha (o secret `SENHA_RAIZ`). O conteúdo vive em `raiz/` (ASSETS).
//
// O «Criar nova escola» usa o `CLOUDFLARE_API_TOKEN` (secret) para criar o Worker e o
// subdomínio da escola nova no Cloudflare, por dentro do próprio Worker — e devolve o URL.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danca",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },
  "main": "workers/raiz.js",
  "assets": {
    "directory": "raiz",
    "binding": "ASSETS",
    // OS ASSETS NÃO PRECISAM DE INVOCAR O WORKER (13/11/2026). O `true` fazia o CSS, o `nav.js`
    // e o favicon gastarem uma invocação cada, e o plano gratuito conta 100.000 por dia. `/*`
    // mantém as páginas e as rotas `/api/` no Worker (é ele que verifica a senha da raiz); a
    // negativa manda os assets direto para o ASSETS, que não é contado.
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },

  // O Cron do expurgo (§17.5): a cada 5 minutos a raiz roda `scheduled`, lê o andaime
  // `raiz/escolas-habilitadas.json` e apaga as escolas desabilitadas com o prazo vencido.
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
