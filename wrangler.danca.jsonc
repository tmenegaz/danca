// Cloudflare Worker da RAIZ do sistema — o `danca`.
//
// NÃO é uma escola: é a porta de entrada do sistema. Serve a apresentação «Sistema Lastro»
// (a MESMA do ciclo, renderizada de biblioteca/apresentacao.md) + o botão «Criar nova
// escola», atrás de senha (o secret `SENHA_RAIZ`). O conteúdo vive em `raiz/` (ASSETS).
//
// O «Criar nova escola» usa o `CLOUDFLARE_API_TOKEN` (secret) para criar o Worker e o
// subdomínio da escola nova no Cloudflare, por dentro do próprio Worker — e devolve o URL.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danca",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },
  "main": "workers/raiz.js",
  "assets": {
    "directory": "raiz",
    "binding": "ASSETS",
    // OS ASSETS NÃO PRECISAM DE INVOCAR O WORKER (13/11/2026). O `true` fazia o CSS, o `nav.js`
    // e o favicon gastarem uma invocação cada, e o plano gratuito conta 100.000 por dia. `/*`
    // mantém as páginas e as rotas `/api/` no Worker (é ele que verifica a senha da raiz); a
    // negativa manda os assets direto para o ASSETS, que não é contado.
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },

  // O KV DAS ESCOLAS, PARA A RAIZ PODER MANTER O MAPA (15/11/2026).
  //
  // O mapa `escolas/por-host` é a lista que diz quais escolas existem num shard — e a raiz é quem
  // cria e quem expurga, por isso é ela que tem de o escrever. Até aqui o mapa era escrito só pelo
  // `tools/publicar-mapa-de-escolas.js`, que o derivava dos `wrangler.<escola>.jsonc`; num shard
  // essas configurações deixam de existir, e o `--podar` passaria a esvaziar o mapa em vez de o
  // podar. O dono do mapa passa a ser quem sabe: a criação regista, o expurgo remove.
  //
  // É o MESMO namespace das escolas (`PADD_KV`): um mapa por casa, não um por Worker — é o que
  // faz um isolate do shard ler o mapa uma vez e servir N escolas.
  "kv_namespaces": [
    {
      "binding": "PADD_KV",
      "id": "2ee331c7a5bc446ca86c8f2cb039ec16"
    }
  ],

  // O SCRIPT DO SHARD (15/11/2026). É o que o expurgo precisa de saber para apagar a ROTA de uma
  // escola servida por ele: a rota aponta ao shard, e não a um script com o nome da escola. Sem
  // isto, a escola expurgada continuaria a responder no endereço dela.
  "vars": {
    "SHARD_SCRIPT": "lastro-teste",

    // OS DOIS ENDEREÇOS DESTA PÁGINA (25/11/2026).
    //
    // A MESMA página serve os dois nomes, e o que os separa é o HOST: `danca.padd.com.br` é o
    // painel do proprietário (com a lista de escolas, «Apagar escola», «Professores»);
    // `lastro.padd.com.br` é a página pública — a mesma apresentação, e SÓ o botão de criar
    // escola. A regra está em `motor/servidor/raiz.js` (`ehPaginaPublica`), e a prova em
    // `experimentos/provar-pagina-publica.js`.
    //
    // `HOST_DONO` é o critério; `HOST_PUBLICO` é o que se MOSTRA e anuncia. São duas `var` e não
    // uma porque respondem a perguntas diferentes: uma decide quem vê o painel, a outra escreve
    // um endereço na tela. O `.workers.dev` conta sempre como o lado do painel, atrás da senha.
    "HOST_DONO": "danca.padd.com.br",
    "HOST_PUBLICO": "lastro.padd.com.br",

    // O REMETENTE DO CORREIO (25/11/2026). O domínio tem de estar verificado no provedor
    // (Resend) para este endereço poder enviar. O TOKEN NÃO ESTÁ AQUI: é o secret
    // `RESEND_API_KEY` (`npx wrangler secret put RESEND_API_KEY --config wrangler.danca.jsonc`).
    // Sem ele o sistema não finge que enviou — compõe, guarda a mensagem e di-lo na tela.
    "CORREIO_DE": "Sistema Lastro <lastro@padd.com.br>",

    // A CHAVE PIX DO PAGAMENTO (25/11/2026). A decisão dela: «a gente vai colocar ali a minha
    // chave Pix e o pagamento direto para a minha conta. Bateu na minha conta, eu verifico e aí
    // libero o acesso» — e «a conciliação bancária é feita por mim, é feita manualmente». Não há
    // gateway, não há cobrança automática e não há QR Code gerado por nós: há uma chave, um valor
    // e uma pessoa que confere o extrato.
    //
    // VAZIA, A PÁGINA DIZ QUE NÃO ESTÁ CONFIGURADA e a escola nasce a aguardar na mesma. É de
    // propósito: uma chave de exemplo num ecrã de pagamento é dinheiro enviado para o lado errado.
    //
    // A CHAVE NÃO FICA AQUI, E A RAZÃO NÃO É ESTÉTICA (25/11/2026). A chave é o CPF dela, e um
    // CPF escrito neste ficheiro fica no histórico do git para sempre, em cada clone, e é lido
    // por qualquer pessoa a quem se dê acesso ao repositório — mesmo depois de a chave mudar de
    // banco. Vai como SEGREDO do Worker, que é o lugar onde já vivem o `GITHUB_TOKEN` e o
    // `RESEND_API_KEY`:
    //
    //     printf '%s' '<a chave>' | npx wrangler secret put PIX_CHAVE -c wrangler.danca.jsonc
    //     printf '%s' '<o nome de quem recebe>' | npx wrangler secret put PIX_TITULAR -c wrangler.danca.jsonc
    //
    // O COMANDO NÃO TRAZ A CHAVE, e é o ponto todo: escrita aqui — mesmo num comentário — ela
    // ficaria no primeiro commit e em cada clone, que é exatamente o que se quer evitar.
    //
    // Um segredo e uma `var` com o mesmo nome são a MESMA chave em `env`, e o deploy recusa
    // manter as duas — por isso `PIX_CHAVE` e `PIX_TITULAR` não estão declaradas acima. O
    // `PIX_TITULAR` pode ficar por pôr: sem ele a página escreve «para o Sistema Lastro», que é
    // verdade sem inventar o nome que o banco exige por extenso.
  },

  // O Cron do expurgo (§17.5): a cada 5 minutos a raiz roda `scheduled`, lê o andaime
  // `raiz/escolas-habilitadas.json` e apaga as escolas desabilitadas com o prazo vencido.
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
